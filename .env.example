# ha-rbac-gateway configuration. Copy to `.env`, fill in, keep it out of git.
# The .env file is the ONLY place a real token lives — never commit it.

# --- Upstream Home Assistant (required) ---
# Base URL of your HA instance as seen from the gateway container.
HA_URL=http://127.0.0.1:8123
# Long-lived access token used ONLY for read-only registry/identity plumbing.
# Create one in HA: Profile -> Security -> Long-lived access tokens.
HA_TOKEN=paste-a-long-lived-access-token-here

# --- Listener ---
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8124

# --- Paths (inside the container) ---
POLICY_DIR=/config/policies
DATA_DIR=/data

# --- Tuning (seconds) ---
IDENTITY_CACHE_TTL=300
REGISTRY_REFRESH_INTERVAL=300
# Registry older than this makes area/domain rules fail closed (deny):
REGISTRY_STALE_MAX=900

# --- Canary self-test (optional but recommended) ---
# A long-lived token belonging to a RESTRICTED test user, used to continuously
# verify that filtering still works. If filtering ever breaks, the canary trips
# the gateway (fail closed). Leave CANARY_TOKEN empty to disable.
CANARY_TOKEN=
CANARY_INTERVAL=21600
# An entity the test user IS allowed to read (canary asserts it stays visible):
CANARY_ALLOWED_READ_ENTITY=
# An entity the test user must NEVER see (canary asserts it stays denied):
CANARY_FORBIDDEN_ENTITY=sun.sun

# --- Admin panel API (optional; see README "Admin panel") ---
# Serves /rbac-admin/api/* for the HA sidebar panel. Admin-token-gated. Requires
# the policies dir to be mounted read-write. Set to false to disable entirely.
ADMIN_API_ENABLED=true

LOG_LEVEL=INFO
